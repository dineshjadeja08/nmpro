# Public URL for metadata. Replace after domain ownership is confirmed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only URL. Never put credentials or private keys in NEXT_PUBLIC variables.
API_BASE_URL=http://127.0.0.1:8000
# Public API origin for browser requests. Contains no secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Customer Phone Auth via Firebase (non-secret public client identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
