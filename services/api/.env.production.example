NAMMAPROS_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=SET_IN_RENDER_ENV
JWT_SIGNING_KEY=SET_IN_RENDER_ENV
DJANGO_ALLOWED_HOSTS=nammapros-api.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-site.netlify.app
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app
DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_CROSS_SITE_COOKIES=true
# Pooled Neon URL (-pooler) for Gunicorn web requests
DATABASE_URL=SET_NEON_POOLED_DATABASE_URL
# Direct unpooled Neon URL (no -pooler) used automatically by migrate commands
DATABASE_URL_UNPOOLED=SET_NEON_DIRECT_DATABASE_URL
# Upstash or managed TLS Redis (rediss://...)
REDIS_URL=SET_UPSTASH_REDISS_URL
PRIVATE_MEDIA_BUCKET=SET_PRIVATE_BUCKET_NAME
FIREBASE_PROJECT_ID=SET_FIREBASE_PROJECT_ID
MSG91_AUTH_KEY=SET_IN_SECRET_MANAGER
MSG91_OTP_TEMPLATE_ID=SET_APPROVED_TEMPLATE_ID
PUBLIC_BOOKING_ENABLED=false
PILOT_ENABLED=false
AUTOMATIC_DISPATCH_ENABLED=false
NEW_SERVICE_ZONES_ENABLED=false
RAZORPAY_ENABLED=false
WHATSAPP_ENABLED=false
TECHNICIAN_PAYOUTS_ENABLED=false
DB_CONN_MAX_AGE=0
DJANGO_HSTS_SECONDS=300
